{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // "mobile" is the Expo app: a separate project with its own tsconfig and its
  // own node_modules. Without excluding it, `next build` type-checks React
  // Native sources against the web app's dependency tree — which works locally
  // (mobile/node_modules exists) but fails on any CI that installs only the
  // root package.json: "Cannot find module 'react-native'".
  //
  // The mobile app is still type-checked, just on its own: cd mobile && tsc.
  "exclude": ["node_modules", "mobile"]
}
