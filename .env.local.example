# Public origin used for canonical links, og:image URLs and the sitemap.
# Optional on Vercel (falls back to VERCEL_PROJECT_PRODUCTION_URL); set it
# once the site has a custom domain, e.g. https://gamelog.app
NEXT_PUBLIC_SITE_URL=

# Search Console "HTML tag" verification — the content="…" value only. Optional:
# the site already carries the token for the vercel.app address; set this when
# verifying a different one (e.g. a custom domain).
GOOGLE_SITE_VERIFICATION=

# Public contact address shown on /privacy for data-deletion requests. Optional;
# leave unset to avoid publishing one.
NEXT_PUBLIC_CONTACT_EMAIL=
